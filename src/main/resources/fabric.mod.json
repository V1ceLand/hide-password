{
	"schemaVersion": 1,
	"id": "passwordmask",
	"version": "${version}",
	"name": "Password Mask",
	"description": "Hides passwords behind asterisks in chat (/login, /register, ...) and in server login dialogs. An eye button next to the field reveals it. / Скрывает пароль звёздочками в чате и окнах входа; кнопка-глазок показывает его.",
	"authors": [
		"kozyr"
	],
	"contact": {
		"homepage": "https://github.com/V1ceLand/password-mask",
		"sources": "https://github.com/V1ceLand/password-mask",
		"issues": "https://github.com/V1ceLand/password-mask/issues"
	},
	"license": "MIT",
	"icon": "assets/passwordmask/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.kozyr.passwordmask.client.PasswordMaskClient"
		]
	},
	"mixins": [
		{
			"config": "passwordmask.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25"
	}
}
